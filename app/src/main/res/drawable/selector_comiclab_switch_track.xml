<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <selector>
            <item android:state_enabled="false">
                <shape android:shape="rectangle">
                    <size android:width="36dp" android:height="20dp" />
                    <corners android:radius="10dp" />
                    <solid android:color="@color/comiclab_divider" />
                    <stroke android:width="1dp" android:color="@color/comiclab_cover_placeholder_border" />
                </shape>
            </item>
            <item android:state_checked="true">
                <shape android:shape="rectangle">
                    <size android:width="36dp" android:height="20dp" />
                    <corners android:radius="10dp" />
                    <solid android:color="@color/comiclab_accent" />
                    <stroke android:width="1dp" android:color="@color/comiclab_accent" />
                </shape>
            </item>
            <item>
                <shape android:shape="rectangle">
                    <size android:width="36dp" android:height="20dp" />
                    <corners android:radius="10dp" />
                    <solid android:color="@color/comiclab_divider" />
                    <stroke android:width="1dp" android:color="@color/comiclab_control_outline" />
                </shape>
            </item>
        </selector>
    </item>
    <item>
        <shape android:shape="rectangle">
            <size android:width="36dp" android:height="20dp" />
            <solid android:color="#00000000" />
            <padding android:left="2dp" android:right="4dp" />
        </shape>
    </item>
</layer-list>
