<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/comiclab_blue_soft" />
            <stroke android:width="1dp" android:color="@color/comiclab_blue" />
        </shape>
    </item>

    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/comiclab_surface_card" />
            <stroke android:width="1dp" android:color="@color/comiclab_divider" />
        </shape>
    </item>
</selector>
