<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="true"
    android:fillViewport="false"
    android:paddingStart="12dp"
    android:paddingEnd="12dp"
>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">
        <LinearLayout
            android:id="@+id/cardReadingDirection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_file_picker_card"
            android:elevation="@dimen/card_elevation"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="14dp"
            android:paddingEnd="16dp"
            android:paddingBottom="14dp">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/reading_direction"
                android:textColor="@color/comiclab_text_primary"
                android:textSize="@dimen/text_section"
                android:textStyle="bold" />
            <RadioGroup
                android:id="@+id/radioReadingDirection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="vertical">
                <RadioButton
                    android:id="@+id/radioTopToBottom"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:buttonTint="@color/comiclab_accent"
                    android:gravity="center_vertical"
                    android:text="@string/reading_direction_top_to_bottom"
                    android:textColor="@color/comiclab_text_secondary"
                    android:textSize="@dimen/text_body" />
                <RadioButton
                    android:id="@+id/radioRightToLeft"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:buttonTint="@color/comiclab_accent"
                    android:gravity="center_vertical"
                    android:text="@string/reading_direction_right_to_left"
                    android:textColor="@color/comiclab_text_secondary"
                    android:textSize="@dimen/text_body" />
                <RadioButton
                    android:id="@+id/radioLeftToRight"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:buttonTint="@color/comiclab_accent"
                    android:gravity="center_vertical"
                    android:text="@string/reading_direction_left_to_right"
                    android:textColor="@color/comiclab_text_secondary"
                    android:textSize="@dimen/text_body" />
            </RadioGroup>
            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/switchDoublePageCoverSingle"
                style="@style/Widget.ComicLab.Switch"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="8dp"
                android:text="@string/double_page_cover_single"
                android:textColor="@color/comiclab_text_secondary"
                android:textSize="@dimen/text_body" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_file_picker_card"
            android:elevation="@dimen/card_elevation"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="14dp"
            android:paddingBottom="14dp"
            android:id="@+id/cardEnhancementScale">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/enhancement_scale"
                android:textColor="@color/comiclab_text_primary"
                android:textSize="@dimen/text_section"
                android:textStyle="bold" />
            <RadioGroup
                android:id="@+id/radioEnhancementScale"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">
                <RadioButton
                    android:id="@+id/radioEnhancement2"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:buttonTint="@color/comiclab_accent"
                    android:text="@string/enhancement_scale_2"
                    android:textColor="@color/comiclab_text_secondary"
                    android:textSize="@dimen/text_body" />
                <RadioButton
                    android:id="@+id/radioEnhancement3"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:buttonTint="@color/comiclab_accent"
                    android:text="@string/enhancement_scale_3"
                    android:textColor="@color/comiclab_text_secondary"
                    android:textSize="@dimen/text_body" />
                <RadioButton
                    android:id="@+id/radioEnhancement4"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:buttonTint="@color/comiclab_accent"
                    android:text="@string/enhancement_scale_4"
                    android:textColor="@color/comiclab_text_secondary"
                    android:textSize="@dimen/text_body" />
            </RadioGroup>
        </LinearLayout>
        <LinearLayout
            android:id="@+id/cardReaderControls"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_file_picker_card"
            android:elevation="@dimen/card_elevation"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="14dp"
            android:paddingEnd="16dp"
            android:paddingBottom="14dp">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/reader_controls"
                android:textColor="@color/comiclab_text_primary"
                android:textSize="@dimen/text_section"
                android:textStyle="bold" />
            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/switchVolumeKeyPageTurn"
                style="@style/Widget.ComicLab.Switch"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical"
                android:text="@string/volume_key_page_turn"
                android:textColor="@color/comiclab_text_secondary"
                android:textSize="@dimen/text_body" />
            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/switchAutoHideSystemBars"
                style="@style/Widget.ComicLab.Switch"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:gravity="center_vertical"
                android:text="@string/auto_hide_system_bars"
                android:textColor="@color/comiclab_text_secondary"
                android:textSize="@dimen/text_body" />
            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/switchCustomReaderBrightness"
                style="@style/Widget.ComicLab.Switch"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:gravity="center_vertical"
                android:text="@string/custom_brightness"
                android:textColor="@color/comiclab_text_secondary"
                android:textSize="@dimen/text_body" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">
                <SeekBar
                    android:id="@+id/sliderSettingsReaderBrightness"
                    style="@style/Widget.ComicLab.SeekBar"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_weight="1"
                    android:max="255"
                    android:progress="128" />
                <TextView
                    android:id="@+id/tvSettingsBrightnessValue"
                    android:layout_width="52dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:gravity="end"
                    android:textColor="@color/comiclab_text_secondary"
                    android:textSize="@dimen/text_value" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
