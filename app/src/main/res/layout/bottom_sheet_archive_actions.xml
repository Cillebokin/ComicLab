<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/comiclab_surface_card"
    android:orientation="vertical"
    android:paddingTop="@dimen/space_sm"
    android:paddingBottom="@dimen/space_lg">

    <TextView
        android:id="@+id/tvArchiveActionTitle"
        android:layout_width="match_parent"
        android:layout_height="@dimen/bottom_sheet_header_height"
        android:ellipsize="end"
        android:gravity="center_vertical"
        android:includeFontPadding="false"
        android:maxLines="2"
        android:paddingStart="@dimen/space_xl"
        android:paddingEnd="@dimen/space_xl"
        android:textColor="@color/comiclab_text_primary"
        android:textSize="@dimen/text_body"
        android:textStyle="bold" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginBottom="@dimen/space_xs"
        android:background="@color/comiclab_divider" />

    <TextView
        android:id="@+id/btnReadComic"
        android:layout_width="match_parent"
        android:layout_height="@dimen/bottom_sheet_action_height"
        android:background="@drawable/bg_bottom_sheet_action_item"
        android:drawablePadding="@dimen/space_lg"
        android:gravity="center_vertical"
        android:includeFontPadding="false"
        android:paddingStart="@dimen/space_xl"
        android:paddingEnd="@dimen/space_xl"
        android:text="@string/read"
        android:textColor="@color/comiclab_text_primary"
        android:textSize="@dimen/text_body"
        app:drawableStartCompat="@drawable/png_read_icon" />

    <TextView
        android:id="@+id/btnFavoriteComicAction"
        android:layout_width="match_parent"
        android:layout_height="@dimen/bottom_sheet_action_height"
        android:background="@drawable/bg_bottom_sheet_action_item"
        android:drawablePadding="@dimen/space_lg"
        android:gravity="center_vertical"
        android:includeFontPadding="false"
        android:paddingStart="@dimen/space_xl"
        android:paddingEnd="@dimen/space_xl"
        android:text="@string/favorite_comic_action"
        android:textColor="@color/comiclab_text_primary"
        android:textSize="@dimen/text_body"
        app:drawableStartCompat="@drawable/png_star_icon" />

    <TextView
        android:id="@+id/btnCopyFileName"
        android:layout_width="match_parent"
        android:layout_height="@dimen/bottom_sheet_action_height"
        android:background="@drawable/bg_bottom_sheet_action_item"
        android:drawablePadding="@dimen/space_lg"
        android:gravity="center_vertical"
        android:includeFontPadding="false"
        android:paddingStart="@dimen/space_xl"
        android:paddingEnd="@dimen/space_xl"
        android:text="@string/copy_file_name"
        android:textColor="@color/comiclab_text_primary"
        android:textSize="@dimen/text_body"
        app:drawableStartCompat="@drawable/png_title_icon" />

    <TextView
        android:id="@+id/btnRenameFileName"
        android:layout_width="match_parent"
        android:layout_height="@dimen/bottom_sheet_action_height"
        android:background="@drawable/bg_bottom_sheet_action_item"
        android:drawablePadding="@dimen/space_lg"
        android:gravity="center_vertical"
        android:includeFontPadding="false"
        android:paddingStart="@dimen/space_xl"
        android:paddingEnd="@dimen/space_xl"
        android:text="@string/rename_file_name"
        android:textColor="@color/comiclab_text_primary"
        android:textSize="@dimen/text_body"
        app:drawableStartCompat="@drawable/png_title_change_icon" />

    <TextView
        android:id="@+id/btnCopyStartMarker"
        android:layout_width="match_parent"
        android:layout_height="@dimen/bottom_sheet_action_height"
        android:background="@drawable/bg_bottom_sheet_action_item"
        android:drawablePadding="@dimen/space_lg"
        android:gravity="center_vertical"
        android:includeFontPadding="false"
        android:paddingStart="@dimen/space_xl"
        android:paddingEnd="@dimen/space_xl"
        android:text="@string/copy_start_marker"
        android:textColor="@color/comiclab_text_primary"
        android:textSize="@dimen/text_body"
        app:drawableStartCompat="@drawable/png_tag_icon" />

    <TextView
        android:id="@+id/btnDeleteFile"
        android:layout_width="match_parent"
        android:layout_height="@dimen/bottom_sheet_action_height"
        android:background="@drawable/bg_bottom_sheet_action_item"
        android:drawablePadding="@dimen/space_lg"
        android:gravity="center_vertical"
        android:includeFontPadding="false"
        android:paddingStart="@dimen/space_xl"
        android:paddingEnd="@dimen/space_xl"
        android:text="@string/delete_file"
        android:textColor="@color/comiclab_danger"
        android:textSize="@dimen/text_body"
        app:drawableStartCompat="@drawable/png_delete_icon" />

</LinearLayout>
