<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/comiclab_file_picker_background"
    tools:context=".MainActivity">

    <View
        android:id="@+id/statusBarBackground"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:background="@color/comiclab_file_picker_background"
        app:layout_constraintTop_toTopOf="parent" />

    <LinearLayout
        android:id="@+id/layoutHeaderCard"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="12dp"
        android:background="@drawable/bg_file_picker_card"
        android:elevation="@dimen/card_elevation"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="12dp"
        android:paddingEnd="16dp"
        android:paddingBottom="12dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/statusBarBackground">

        <LinearLayout
            android:id="@+id/linearLayoutTitle"
            android:layout_width="match_parent"
            android:layout_height="28dp"
            android:background="@android:color/transparent"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:fontFamily="sans-serif-medium"
                android:text="@string/app_name"
                android:textColor="@color/comiclab_text_primary"
                android:textSize="@dimen/text_app_title"
                android:letterSpacing="-0.02" />

            <View
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1" />

            <ImageButton
                android:id="@+id/btnHelp"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_marginEnd="16dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/help"
                android:padding="4dp"
                android:scaleType="centerInside"
                android:src="@drawable/png_help_question_icon"
                android:tint="@color/comiclab_icon" />

            <ImageButton
                android:id="@+id/btnOptions"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/settings"
                android:padding="4dp"
                android:scaleType="centerInside"
                android:src="@drawable/png_cog_icon"
                android:tint="@color/comiclab_icon" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/linearLayoutPath"
            android:layout_width="match_parent"
            android:layout_height="32dp"
            android:layout_marginTop="6dp"
            android:background="@android:color/transparent"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/etPath"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@android:color/transparent"
                android:clickable="false"
                android:ellipsize="end"
                android:focusable="false"
                android:gravity="center_vertical"
                android:maxLines="1"
                android:singleLine="true"
                android:text="@string/path_placeholder"
                android:textColor="@color/comiclab_text_secondary"
                android:textSize="@dimen/text_value" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/linearLayoutTool"
        android:layout_width="0dp"
        android:layout_height="52dp"
        android:layout_marginStart="12dp"
        android:layout_marginTop="10dp"
        android:layout_marginEnd="12dp"
        android:background="@drawable/bg_file_picker_card"
        android:elevation="@dimen/card_elevation"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/layoutHeaderCard">

        <ImageButton
            android:id="@+id/btnFavoritePaths"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/favorite_paths"
            android:padding="4dp"
            android:scaleType="centerInside"
            android:src="@drawable/png_mark_direct_icon"
            android:tint="@color/comiclab_icon" />

        <ImageButton
            android:id="@+id/btnFavoriteComics"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_marginStart="16dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/favorite_comics"
            android:padding="4dp"
            android:scaleType="centerInside"
            android:src="@drawable/png_mark_file_icon"
            android:tint="@color/comiclab_icon" />

        <ImageButton
            android:id="@+id/btnReadingHistory"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_marginStart="16dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/reading_history"
            android:padding="4dp"
            android:scaleType="centerInside"
            android:src="@drawable/png_read_history_icon"
            android:tint="@color/comiclab_icon" />

        <View
            android:id="@+id/toolbarModeSpacer"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1" />

        <ImageButton
            android:id="@+id/btnSort"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_marginStart="16dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/sort"
            android:padding="4dp"
            android:scaleType="centerInside"
            android:src="@drawable/png_sort_icon"
            android:tint="@color/comiclab_icon" />

        <ImageButton
            android:id="@+id/btnClassify"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_marginStart="16dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/classify_comics"
            android:padding="4dp"
            android:scaleType="centerInside"
            android:src="@drawable/png_classify_icon"
            android:tint="@color/comiclab_icon" />

        <ImageButton
            android:id="@+id/btnSearch"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_marginStart="16dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/search"
            android:padding="4dp"
            android:scaleType="centerInside"
            android:src="@drawable/png_search_icon"
            android:tint="@color/comiclab_icon" />

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_marginStart="16dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/back"
            android:padding="4dp"
            android:scaleType="centerInside"
            android:src="@drawable/png_back_icon"
            android:tint="@color/comiclab_icon" />

        <ImageButton
            android:id="@+id/btnCreateTransferDirectory"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_marginStart="16dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/create_directory_name"
            android:padding="4dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_folder_add"
            android:tint="@color/comiclab_icon"
            android:visibility="gone" />

        <ImageButton
            android:id="@+id/btnPasteFile"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_marginStart="16dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/paste_file"
            android:padding="4dp"
            android:scaleType="centerInside"
            android:src="@drawable/png_file_copy_icon"
            android:tint="@color/comiclab_icon"
            android:visibility="gone" />

        <ImageButton
            android:id="@+id/btnExitFileTransfer"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_marginStart="16dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/exit_file_transfer"
            android:padding="4dp"
            android:scaleType="centerInside"
            android:src="@drawable/png_file_transfer_exit_icon"
            android:tint="@color/comiclab_danger"
            android:visibility="gone" />

        <ImageButton
            android:id="@+id/btnTransferParent"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_marginStart="16dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/go_parent_directory"
            android:padding="4dp"
            android:scaleType="centerInside"
            android:src="@drawable/png_back_icon"
            android:tint="@color/comiclab_icon"
            android:visibility="gone" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/fileListPanel"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="12dp"
        android:layout_marginTop="10dp"
        android:layout_marginEnd="12dp"
        android:layout_marginBottom="12dp"
        android:background="@drawable/bg_file_picker_card"
        android:clipToOutline="true"
        android:elevation="@dimen/card_elevation"
        android:paddingTop="4dp"
        android:paddingBottom="4dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/linearLayoutTool">

        <com.example.comiclab.BookcaseAwareListView
            android:id="@+id/listFiles"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@android:color/transparent"
            android:choiceMode="none"
            android:clipToPadding="true"
            android:divider="@drawable/divider_file_picker_item"
            android:dividerHeight="1dp"
            android:listSelector="@android:color/transparent"
            android:paddingBottom="76dp" />

        <FrameLayout
            android:id="@+id/nasEmptyState"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone">

            <LinearLayout
                android:id="@+id/nasEmptyPlaceholder"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingStart="28dp"
                android:paddingEnd="28dp"
                android:paddingBottom="76dp">

                <ImageView
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_nas_server"
                    android:tint="@color/comiclab_icon_placeholder" />

                <TextView
                    android:id="@+id/tvNasEmptyTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center"
                    android:text="@string/nas_not_connected_title"
                    android:textColor="@color/comiclab_text_primary"
                    android:textSize="@dimen/text_section" />

                <TextView
                    android:id="@+id/tvNasEmptyMessage"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center"
                    android:text="@string/nas_not_connected_message"
                    android:textColor="@color/comiclab_text_secondary"
                    android:textSize="@dimen/text_caption" />

                <Button
                    android:id="@+id/btnNasManageShares"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/bg_preview_action_button"
                    android:text="@string/nas_manage_shares"
                    android:textColor="@color/white"
                    android:textSize="@dimen/text_value" />

                <TextView
                    android:id="@+id/btnNasCacheManagementEmpty"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:layout_marginTop="8dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:gravity="center"
                    android:minWidth="100dp"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:text="@string/nas_cache_button_manage"
                    android:textColor="@color/comiclab_accent"
                    android:textSize="@dimen/text_value"
                    android:visibility="gone" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/nasBrowserContent"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:paddingBottom="76dp"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="16dp"
                    android:paddingEnd="12dp">

                    <TextView
                        android:id="@+id/btnNasCacheManagement"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:gravity="center"
                        android:minWidth="64dp"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp"
                        android:text="@string/nas_cache_button_empty"
                        android:textColor="@color/comiclab_accent"
                        android:textSize="@dimen/text_caption"
                        android:visibility="gone" />

                    <View
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1" />

                    <TextView
                        android:id="@+id/btnNasSwitchShare"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:gravity="center"
                        android:minWidth="64dp"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp"
                        android:text="@string/nas_switch_share"
                        android:textColor="@color/comiclab_accent"
                        android:textSize="@dimen/text_caption"
                        android:visibility="gone" />
                </LinearLayout>

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1">

                    <ListView
                        android:id="@+id/listNasFiles"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@android:color/transparent"
                        android:choiceMode="none"
                        android:clipToPadding="true"
                        android:divider="@drawable/divider_file_picker_item"
                        android:dividerHeight="1dp"
                        android:listSelector="@android:color/transparent"
                        android:visibility="gone" />

                    <LinearLayout
                        android:id="@+id/nasLoadingPanel"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <ProgressBar
                            android:layout_width="40dp"
                            android:layout_height="40dp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:text="@string/nas_loading_directory"
                            android:textColor="@color/comiclab_text_secondary"
                            android:textSize="@dimen/text_caption" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/nasStatusPanel"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:paddingStart="24dp"
                        android:paddingEnd="24dp"
                        android:visibility="gone">

                        <TextView
                            android:id="@+id/tvNasBrowserStatus"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:textColor="@color/comiclab_text_secondary"
                            android:textSize="@dimen/text_caption" />

                        <Button
                            android:id="@+id/btnNasRetry"
                            android:layout_width="wrap_content"
                            android:layout_height="40dp"
                            android:layout_marginTop="12dp"
                            android:background="@drawable/bg_preview_action_button"
                            android:text="@string/retry"
                            android:textColor="@color/white"
                            android:textSize="@dimen/text_value"
                            android:visibility="gone" />
                    </LinearLayout>
                </FrameLayout>

                <TextView
                    android:id="@+id/tvNasEmptyHint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:paddingStart="16dp"
                    android:paddingTop="6dp"
                    android:paddingEnd="16dp"
                    android:paddingBottom="6dp"
                    android:text="@string/nas_empty_directory"
                    android:textColor="@color/comiclab_text_secondary"
                    android:textSize="@dimen/text_caption"
                    android:visibility="gone" />
            </LinearLayout>
        </FrameLayout>

        <TextView
            android:id="@+id/nasPathStateSink"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />

        <FrameLayout
            android:id="@+id/sourceSwitchDock"
            android:layout_width="match_parent"
            android:layout_height="76dp"
            android:layout_gravity="bottom|center_horizontal"
            android:background="@drawable/bg_file_source_dock"
            android:focusable="false"
            android:visibility="gone">

            <FrameLayout
                android:id="@+id/sourceSwitchTrack"
                android:layout_width="194dp"
                android:layout_height="48dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_file_source_switch_track"
                android:clipToOutline="true"
                android:elevation="2dp"
                android:padding="4dp">

                <View
                    android:id="@+id/sourceSwitchThumb"
                    android:layout_width="93dp"
                    android:layout_height="40dp"
                    android:layout_gravity="start|center_vertical"
                    android:background="@drawable/bg_file_source_switch_thumb" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:id="@+id/btnSourceNas"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:clickable="true"
                        android:contentDescription="@string/source_nas"
                        android:focusable="true"
                        android:gravity="center"
                        android:orientation="horizontal">

                        <ImageView
                            android:id="@+id/ivSourceNasIcon"
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_nas_server"
                            android:tint="@color/comiclab_text_secondary" />

                        <TextView
                            android:id="@+id/tvSourceNasLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:fontFamily="sans-serif-medium"
                            android:text="@string/source_nas"
                            android:textColor="@color/comiclab_text_secondary"
                            android:textSize="13sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/btnSourceLocal"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:clickable="true"
                        android:contentDescription="@string/source_local"
                        android:focusable="true"
                        android:gravity="center"
                        android:orientation="horizontal">

                        <ImageView
                            android:id="@+id/ivSourceLocalIcon"
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_source_phone"
                            android:tint="@color/comiclab_text_on_accent" />

                        <TextView
                            android:id="@+id/tvSourceLocalLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:fontFamily="sans-serif-medium"
                            android:text="@string/source_local"
                            android:textColor="@color/comiclab_text_on_accent"
                            android:textSize="13sp" />
                    </LinearLayout>
                </LinearLayout>
            </FrameLayout>
        </FrameLayout>
    </FrameLayout>

    <View
        android:id="@+id/readingHistoryScrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#66000000"
        android:clickable="true"
        android:elevation="4dp"
        android:focusable="true"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
