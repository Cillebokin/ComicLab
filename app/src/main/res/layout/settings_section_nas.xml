<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="true"
    android:fillViewport="true"
    android:paddingStart="12dp"
    android:paddingEnd="12dp"
>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvNasShareConfigError"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_file_picker_card"
            android:padding="16dp"
            android:textColor="@color/comiclab_danger"
            android:textSize="@dimen/text_caption"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/nasSettingsEmptyState"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_file_picker_card"
            android:elevation="@dimen/card_elevation"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="24dp"
            android:paddingEnd="20dp"
            android:paddingBottom="24dp">

            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_nas_server"
                android:tint="@color/comiclab_icon_placeholder" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:text="@string/nas_no_saved_shares_title"
                android:textColor="@color/comiclab_text_primary"
                android:textSize="@dimen/text_section" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:text="@string/nas_no_saved_shares_message"
                android:textColor="@color/comiclab_text_secondary"
                android:textSize="@dimen/text_caption" />

            <Button
                android:id="@+id/btnNasAddFirstShare"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_marginTop="18dp"
                android:background="@drawable/bg_preview_action_button"
                android:text="@string/nas_add_share"
                android:textColor="@color/white"
                android:textSize="@dimen/text_value" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/nasShareListContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone" />

        <Button
            android:id="@+id/btnNasAddShare"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="4dp"
            android:background="@drawable/bg_preview_action_button"
            android:text="@string/nas_add_share"
            android:textColor="@color/white"
            android:textSize="@dimen/text_value"
            android:visibility="gone" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="center"
            android:text="@string/nas_read_only_note"
            android:textColor="@color/comiclab_text_tertiary"
            android:textSize="@dimen/text_caption" />
    </LinearLayout>
</ScrollView>
