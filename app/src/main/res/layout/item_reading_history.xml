<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="76dp"
    android:background="@android:color/white">

    <TextView
        android:id="@+id/btnDeleteReadingHistory"
        android:layout_width="72dp"
        android:layout_height="match_parent"
        android:layout_gravity="end"
        android:background="#D93025"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:text="@string/delete"
        android:textColor="@android:color/white"
        android:textSize="14sp"
        android:textStyle="bold" />

    <LinearLayout
        android:id="@+id/layoutReadingHistoryForeground"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="?attr/selectableItemBackground"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingEnd="8dp">

        <ImageView
            android:id="@+id/imgReadingHistoryCover"
            android:layout_width="52dp"
            android:layout_height="60dp"
            android:background="#111111"
            android:contentDescription="@string/comic_cover"
            android:scaleType="centerInside"
            android:src="@drawable/png_press_package_icon" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:paddingTop="6dp"
            android:paddingBottom="6dp">

            <TextView
                android:id="@+id/tvReadingHistoryName"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:gravity="center_vertical"
                android:maxLines="2"
                android:textColor="#222222"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tvReadingHistoryPath"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="#888888"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
