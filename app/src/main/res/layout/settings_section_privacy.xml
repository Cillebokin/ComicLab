<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="true"
    android:paddingStart="12dp"
    android:paddingEnd="12dp">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_file_picker_card"
        android:elevation="@dimen/card_elevation"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:text="@string/privacy_settings_scope"
            android:textColor="@color/comiclab_text_secondary"
            android:textSize="@dimen/text_body" />

        <TextView
            android:id="@+id/tvPrivacyCredentialState"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:text="@string/privacy_credentials_uninitialized"
            android:textColor="@color/comiclab_text_secondary"
            android:textSize="@dimen/text_body" />

        <TextView
            android:id="@+id/tvPrivacyResetHelp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:text="@string/privacy_settings_reset"
            android:textColor="@color/comiclab_text_secondary"
            android:textSize="@dimen/text_body"
            android:visibility="gone" />

        <Button
            android:id="@+id/btnPrivacySetupCredentials"
            style="@style/Widget.ComicLab.Button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/privacy_setup_credentials"
            android:visibility="gone" />

        <Button
            android:id="@+id/btnPrivacyRepairPattern"
            style="@style/Widget.ComicLab.Button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/privacy_repair_pattern"
            android:visibility="gone" />

        <Button
            android:id="@+id/btnPrivacyChangePin"
            style="@style/Widget.ComicLab.Button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/privacy_change_pin"
            android:visibility="gone" />

        <Button
            android:id="@+id/btnPrivacyChangePattern"
            style="@style/Widget.ComicLab.Button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/privacy_change_pattern"
            android:visibility="gone" />
    </LinearLayout>
</ScrollView>
