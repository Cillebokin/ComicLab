<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="4dp"
    android:paddingTop="4dp"
    android:paddingEnd="4dp"
    android:paddingBottom="4dp">

    <TextView
        android:id="@+id/tvComicMigrationTargetFileName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="10dp"
        android:textColor="@color/comiclab_text_primary"
        android:textSize="18sp" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/comiclab_divider" />

    <TextView
        android:id="@+id/tvComicMigrationTargetMarker"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="10dp"
        android:paddingBottom="10dp"
        android:textColor="@color/comiclab_text_primary"
        android:textSize="@dimen/text_body"
        android:textStyle="bold" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/comiclab_divider" />

    <TextView
        android:id="@+id/tvComicMigrationTargetLabel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="10dp"
        android:paddingBottom="4dp"
        android:textColor="@color/comiclab_text_primary"
        android:textSize="@dimen/text_body"
        android:textStyle="bold" />

    <ListView
        android:id="@+id/listComicMigrationTargetDirectories"
        android:layout_width="match_parent"
        android:layout_height="320dp"
        android:background="@android:color/transparent"
        android:clipToPadding="false"
        android:divider="@drawable/divider_file_picker_item"
        android:dividerHeight="1dp"
        android:listSelector="@android:color/transparent" />
</LinearLayout>
