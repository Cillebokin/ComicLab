<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="true"
    android:fillViewport="false"
    android:paddingStart="12dp"
    android:paddingEnd="12dp"
>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">
        <LinearLayout
            android:id="@+id/cardTranslationSettings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:background="@drawable/bg_file_picker_card"
            android:elevation="@dimen/card_elevation"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="14dp"
            android:paddingEnd="16dp"
            android:paddingBottom="14dp">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/translation_section_title"
                android:textColor="@color/comiclab_text_primary"
                android:textSize="@dimen/text_section"
                android:textStyle="bold" />
            <Button
                android:id="@+id/btnTranslationSettings"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_preview_action_button"
                android:text="@string/translation_settings"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textSize="@dimen/text_value" />
            <Button
                android:id="@+id/btnTranslationLicenses"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_preview_action_button"
                android:text="@string/translation_licenses"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textSize="@dimen/text_value" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/cardConfigurationManagement"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_file_picker_card"
            android:elevation="@dimen/card_elevation"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="14dp"
            android:paddingEnd="16dp"
            android:paddingBottom="14dp">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/configuration_management"
                android:textColor="@color/comiclab_text_primary"
                android:textSize="@dimen/text_section"
                android:textStyle="bold" />
            <Button
                android:id="@+id/btnExportConfiguration"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_preview_action_button"
                android:text="@string/export_configuration"
                android:textColor="@color/white"
                android:textSize="@dimen/text_value" />
            <Button
                android:id="@+id/btnImportConfiguration"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_preview_action_button"
                android:text="@string/import_configuration"
                android:textColor="@color/white"
                android:textSize="@dimen/text_value" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
