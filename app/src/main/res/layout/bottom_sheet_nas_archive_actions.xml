<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_bottom_sheet_surface"
    android:clipToOutline="true"
    android:orientation="vertical"
    android:paddingTop="@dimen/space_sm"
    android:paddingBottom="@dimen/space_lg">

    <TextView
        android:id="@+id/tvNasArchiveActionTitle"
        android:layout_width="match_parent"
        android:layout_height="@dimen/bottom_sheet_header_height"
        android:ellipsize="end"
        android:gravity="center_vertical"
        android:includeFontPadding="false"
        android:maxLines="2"
        android:paddingStart="@dimen/space_xl"
        android:paddingEnd="@dimen/space_xl"
        android:textColor="@color/comiclab_text_primary"
        android:textSize="@dimen/text_body"
        android:textStyle="bold" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginStart="@dimen/space_xl"
        android:layout_marginEnd="@dimen/space_xl"
        android:layout_marginBottom="@dimen/space_xs"
        android:background="@color/comiclab_divider" />

    <TextView
        android:id="@+id/btnReadNasArchive"
        android:drawableTint="@color/comiclab_icon"
        android:layout_width="match_parent"
        android:layout_height="@dimen/bottom_sheet_action_height"
        android:background="@drawable/bg_bottom_sheet_action_item"
        android:drawablePadding="@dimen/space_lg"
        android:gravity="center_vertical"
        android:includeFontPadding="false"
        android:paddingStart="@dimen/space_xl"
        android:paddingEnd="@dimen/space_xl"
        android:text="@string/read"
        android:textColor="@color/comiclab_text_primary"
        android:textSize="@dimen/text_body"
        app:drawableStartCompat="@drawable/png_read_icon" />

    <TextView
        android:id="@+id/btnDownloadNasArchiveToLocal"
        android:drawableTint="@color/comiclab_icon"
        android:layout_width="match_parent"
        android:layout_height="@dimen/bottom_sheet_action_height"
        android:background="@drawable/bg_bottom_sheet_action_item"
        android:drawablePadding="@dimen/space_lg"
        android:gravity="center_vertical"
        android:includeFontPadding="false"
        android:paddingStart="@dimen/space_xl"
        android:paddingEnd="@dimen/space_xl"
        android:text="@string/nas_download_to_local"
        android:textColor="@color/comiclab_text_primary"
        android:textSize="@dimen/text_body"
        app:drawableStartCompat="@drawable/ic_nas_download_file_action" />
</LinearLayout>
