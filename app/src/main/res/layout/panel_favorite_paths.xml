<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/white"
    android:orientation="vertical">

    <TextView
        android:id="@+id/tvFavoritePathsTitle"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:background="@color/comiclab_blue"
        android:gravity="center_vertical"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:text="@string/favorite_paths"
        android:textColor="@android:color/white"
        android:textSize="16sp"
        android:textStyle="bold" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/listFavoritePaths"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tvFavoritePathsEmpty"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="@string/favorite_paths_empty"
            android:textColor="#777777"
            android:textSize="14sp" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="end|center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingTop="8dp"
        android:paddingEnd="12dp"
        android:paddingBottom="8dp">

        <Button
            android:id="@+id/btnClearFavoritePaths"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:background="@drawable/bg_preview_action_button"
            android:backgroundTint="@null"
            android:minHeight="0dp"
            android:minWidth="80dp"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:text="@string/clear"
            android:textColor="@color/white"
            android:textSize="12sp" />
    </LinearLayout>
</LinearLayout>
