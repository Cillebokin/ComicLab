<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="true"
    android:fillViewport="false"
    android:paddingStart="12dp"
    android:paddingEnd="12dp"
>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">
        <LinearLayout
            android:id="@+id/cardFileBrowser"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_file_picker_card"
            android:elevation="@dimen/card_elevation"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="14dp"
            android:paddingEnd="16dp"
            android:paddingBottom="14dp">
            <TextView
                android:id="@+id/tvStartMarkerErrorTags"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:labelFor="@id/inputStartMarkerErrorTags"
                android:text="@string/start_marker_error_tags"
                android:textColor="@color/comiclab_text_secondary"
                android:textSize="@dimen/text_body" />
            <EditText
                android:id="@+id/inputStartMarkerErrorTags"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:hint="@string/start_marker_error_tags_empty_hint"
                android:importantForAutofill="no"
                android:inputType="text"
                android:maxLines="1"
                android:singleLine="true"
                android:textColor="@color/comiclab_text_primary"
                android:textColorHint="@color/comiclab_text_tertiary"
                android:textSize="@dimen/text_body" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>