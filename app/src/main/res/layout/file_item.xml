<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="@dimen/file_item_height"
    android:background="@drawable/bg_file_item"
    android:orientation="horizontal">

    <FrameLayout
        android:id="@+id/iconContainer"
        android:layout_width="64dp"
        android:layout_height="match_parent"
        android:clipChildren="true">

        <ImageView
            android:id="@+id/imgIcon"
            android:layout_width="@dimen/file_item_regular_icon_size"
            android:layout_height="@dimen/file_item_regular_icon_size"
            android:layout_gravity="center"
            android:contentDescription="@string/file_item"
            android:padding="4dp" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/collectionCoverList"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:overScrollMode="never"
            android:scrollbars="none"
            android:visibility="gone" />
    </FrameLayout>

    <LinearLayout
        android:id="@+id/itemInfoContainer"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:paddingStart="@dimen/space_sm"
        android:paddingTop="13dp"
        android:paddingEnd="@dimen/space_md"
        android:paddingBottom="13dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:gravity="center_vertical"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:textColor="@color/comiclab_text_primary"
                android:textSize="@dimen/text_body" />

            <ImageView
                android:id="@+id/imgFavoriteMarker"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginStart="@dimen/space_sm"
                android:layout_marginEnd="@dimen/space_xs"
                android:contentDescription="@string/favorite_marker"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tvTypeMarker"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="end|center_vertical"
                android:includeFontPadding="false"
                android:fontFamily="sans-serif-medium"
                android:textColor="@color/comiclab_text_secondary"
                android:textSize="@dimen/text_caption" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvInfo"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:gravity="center_vertical"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:textColor="@color/comiclab_text_secondary"
                android:textSize="@dimen/text_caption" />

            <TextView
                android:id="@+id/tvDate"
                android:layout_width="86dp"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:gravity="end|center_vertical"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:textColor="@color/comiclab_text_tertiary"
                android:textSize="@dimen/text_caption" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
