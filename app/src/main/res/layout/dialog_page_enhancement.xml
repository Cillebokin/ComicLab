<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@color/black" android:padding="12dp">
    <TextView android:id="@+id/tvEnhancementTitle" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:textColor="@color/white" android:textSize="18sp" />
    <com.example.comiclab.ui.reader.manga.ReaderSubsamplingImageView
        android:id="@+id/imageEnhancement" android:layout_width="match_parent"
        android:layout_height="0dp" android:layout_weight="1" />
    <TextView android:id="@+id/tvEnhancementStatus" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:textColor="@color/white" android:textSize="14sp"
        android:paddingTop="8dp" android:paddingBottom="8dp" />
    <ProgressBar android:id="@+id/progressEnhancement" style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent" android:layout_height="8dp" android:max="100" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="8dp">
        <Button android:id="@+id/btnEnhancementOriginal" android:textColor="@color/enhancement_comparison_text" android:layout_width="0dp"
            android:layout_height="48dp" android:layout_weight="1" android:minWidth="0dp"
            android:paddingStart="4dp" android:paddingEnd="4dp" android:paddingTop="0dp" android:paddingBottom="0dp"
            android:singleLine="true" android:textSize="14sp" android:includeFontPadding="false"
            android:text="@string/reader_enhance_original" android:textAllCaps="false" android:enabled="false" />
        <Button android:id="@+id/btnEnhancementResult" android:textColor="@color/enhancement_comparison_text" android:layout_width="0dp"
            android:layout_height="48dp" android:layout_weight="1" android:minWidth="0dp"
            android:paddingStart="4dp" android:paddingEnd="4dp" android:paddingTop="0dp" android:paddingBottom="0dp"
            android:singleLine="true" android:textSize="14sp" android:includeFontPadding="false"
            android:layout_marginStart="8dp"
            android:text="@string/reader_enhance_result" android:textAllCaps="false" android:enabled="false" />
        <Button android:id="@+id/btnEnhancementSave" android:layout_width="0dp"
            android:layout_height="48dp" android:layout_weight="1"
            android:paddingStart="4dp" android:paddingEnd="4dp" android:paddingTop="0dp" android:paddingBottom="0dp"
            android:singleLine="true" android:textSize="14sp" android:includeFontPadding="false"
            android:layout_marginStart="8dp" android:minWidth="0dp"
            android:text="@string/reader_enhance_save" android:textAllCaps="false" android:enabled="false" />
        <Button android:id="@+id/btnEnhancementClose" android:layout_width="0dp"
            android:layout_height="48dp" android:layout_weight="1" android:minWidth="0dp"
            android:paddingStart="4dp" android:paddingEnd="4dp" android:paddingTop="0dp" android:paddingBottom="0dp"
            android:singleLine="true" android:textSize="14sp" android:includeFontPadding="false"
            android:layout_marginStart="8dp"
            android:text="@android:string/cancel" android:textAllCaps="false" />
    </LinearLayout>
</LinearLayout>
