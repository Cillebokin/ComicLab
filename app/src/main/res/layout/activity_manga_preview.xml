<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/comiclab_file_picker_background"
    android:clipToPadding="true"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="12dp">

        <View
            android:id="@+id/statusBarBackground"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:background="@color/comiclab_file_picker_background" />

        <LinearLayout
            android:id="@+id/layoutPreviewInfoCard"
            android:layout_width="match_parent"
            android:layout_height="@dimen/preview_header_height"
            android:layout_marginStart="12dp"
            android:layout_marginTop="12dp"
            android:layout_marginEnd="12dp"
            android:background="@drawable/bg_file_picker_card"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="@dimen/space_md"
            android:paddingTop="@dimen/space_md"
            android:paddingEnd="@dimen/space_md"
            android:paddingBottom="@dimen/space_md">

            <FrameLayout
                android:layout_width="@dimen/preview_header_cover_width"
                android:layout_height="match_parent"
                android:paddingEnd="@dimen/space_sm">

                <ImageView
                    android:id="@+id/imgCover"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_gravity="start"
                    android:background="@drawable/bg_preview_cover"
                    android:contentDescription="@string/comic_cover"
                    android:scaleType="fitCenter" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="@dimen/space_sm"
                android:layout_weight="1"
                android:gravity="start"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvComicName"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:gravity="top|start"
                    android:includeFontPadding="false"
                    android:maxLines="5"
                    android:textColor="@color/black"
                    android:textSize="19sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvComicFileSize"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:gravity="end"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:textColor="@color/comiclab_text_secondary"
                    android:textSize="@dimen/text_caption" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/layoutPreviewActionCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginTop="10dp"
            android:layout_marginEnd="12dp"
            android:background="@drawable/bg_file_picker_card"
            android:orientation="vertical"
            android:paddingStart="@dimen/space_md"
            android:paddingTop="@dimen/space_md"
            android:paddingEnd="@dimen/space_md"
            android:paddingBottom="@dimen/space_md">

            <LinearLayout
                android:id="@+id/layoutReadingProgress"
                android:layout_width="match_parent"
                android:layout_height="20dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ProgressBar
                    android:id="@+id/progressReading"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="0dp"
                    android:layout_height="5dp"
                    android:layout_weight="1"
                    android:indeterminate="false"
                    android:max="0"
                    android:progress="0"
                    android:progressBackgroundTint="@color/comiclab_divider"
                    android:progressTint="@color/comiclab_blue" />

                <TextView
                    android:id="@+id/tvReadingProgress"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_xs"
                    android:ellipsize="end"
                    android:gravity="end"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:text="@string/preview_reading_progress_empty"
                    android:textColor="@color/comiclab_text_secondary"
                    android:textSize="@dimen/text_caption" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_sm"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvStatus"
                    android:layout_width="0dp"
                    android:layout_height="28dp"
                    android:layout_weight="1"
                    android:gravity="center_vertical"
                    android:includeFontPadding="false"
                    android:text="@string/loading_preview"
                    android:textColor="@color/comiclab_text_secondary"
                    android:textSize="@dimen/text_caption" />

                <ImageButton
                    android:id="@+id/btnFullRead"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/full_read"
                    android:padding="8dp"
                    android:scaleType="centerInside"
                    android:src="@drawable/png_read_icon" />

                <ImageButton
                    android:id="@+id/btnExitPreview"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginStart="@dimen/space_sm"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/exit_preview"
                    android:padding="8dp"
                    android:scaleType="centerInside"
                    android:src="@drawable/png_back_icon" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/layoutPreviewGridCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginTop="10dp"
            android:layout_marginEnd="12dp"
            android:background="@drawable/bg_file_picker_card"
            android:orientation="vertical"
            android:paddingStart="@dimen/space_md"
            android:paddingTop="@dimen/space_md"
            android:paddingEnd="@dimen/space_md"
            android:paddingBottom="@dimen/space_md">

            <GridLayout
                android:id="@+id/gridPreview"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:columnCount="3"
                android:useDefaultMargins="false" />

            <Button
                android:id="@+id/btnTogglePreview"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_marginTop="@dimen/space_sm"
                android:background="@drawable/bg_preview_action_button"
                android:backgroundTint="@null"
                android:minHeight="0dp"
                android:text="@string/preview_all"
                android:textColor="@color/white"
                android:textSize="@dimen/text_caption"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
