<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.ComicLab" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/comiclab_accent</item>
        <item name="colorOnPrimary">@color/comiclab_text_on_accent</item>
        <item name="colorSecondary">@color/comiclab_accent</item>
        <item name="colorOnSecondary">@color/comiclab_text_on_accent</item>
        <item name="colorAccent">@color/comiclab_accent</item>
        <item name="colorControlActivated">@color/comiclab_accent</item>
        <item name="android:colorAccent">@color/comiclab_accent</item>
        <item name="android:colorControlActivated">@color/comiclab_accent</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:windowFullscreen">false</item>
        <item name="android:statusBarColor">@color/comiclab_file_picker_background</item>
        <item name="android:navigationBarColor">@color/comiclab_file_picker_background</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="materialButtonStyle">@style/Widget.ComicLab.Button</item>
        <item name="android:editTextStyle">@style/Widget.ComicLab.EditText</item>
    </style>

    <style name="Widget.ComicLab.Button" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/comiclab_button_tint</item>
        <item name="android:textColor">@color/comiclab_text_on_accent</item>
        <item name="cornerRadius">8dp</item>
    </style>
</resources>
