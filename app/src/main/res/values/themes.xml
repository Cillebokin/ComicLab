<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.ComicLab" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/comiclab_accent</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/comiclab_accent</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="colorAccent">@color/comiclab_accent</item>
        <item name="colorControlActivated">@color/comiclab_accent</item>
        <item name="android:colorAccent">@color/comiclab_accent</item>
        <item name="android:colorControlActivated">@color/comiclab_accent</item>
        <item name="android:windowFullscreen">false</item>
        <item name="android:statusBarColor">@color/comiclab_accent</item>
        <item name="android:navigationBarColor">@color/white</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="materialButtonStyle">@style/Widget.ComicLab.Button</item>
    </style>

    <style name="Theme.ComicLab" parent="Base.Theme.ComicLab" />

    <style name="Animation_ComicLab_ReadingHistoryPanel">
        <item name="android:windowEnterAnimation">@anim/reading_history_panel_enter</item>
        <item name="android:windowExitAnimation">@anim/reading_history_panel_exit</item>
    </style>

    <style name="Widget.ComicLab.Button" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/comiclab_button_tint</item>
        <item name="android:textColor">@color/white</item>
        <item name="cornerRadius">8dp</item>
    </style>
</resources>
